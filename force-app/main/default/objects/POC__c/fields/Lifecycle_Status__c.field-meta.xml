<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
            <fullName>Lifecycle_Status__c</fullName>
            <label>Lifecycle Status</label>
            <description>The current stage of the POC engagement. Drives the native Kanban board columns.</description>
            <type>Picklist</type>
            <inlineHelpText>Move this forward as the engagement progresses — it drives which Kanban column the POC appears in.</inlineHelpText>
            <required>true</required>
            <trackHistory>false</trackHistory>
            
            <!-- Field Level Security - Visible and Editable for all profiles by default -->
            <securityClassification>Public</securityClassification>
            <complianceGroup>None</complianceGroup>
            
            <valueSet>
                <restricted>true</restricted>
                <valueSetDefinition>
                    <sorted>false</sorted>
                    
                    <value>
                        <fullName>Pre-POC</fullName>
                        <default>true</default>
                        <label>Pre-POC</label>
                    </value>
                    
                    <value>
                        <fullName>Active</fullName>
                        <default>false</default>
                        <label>Active</label>
                    </value>
                    
                    <value>
                        <fullName>Extended</fullName>
                        <default>false</default>
                        <label>Extended</label>
                    </value>
                    
                    <value>
                        <fullName>Paused</fullName>
                        <default>false</default>
                        <label>Paused</label>
                    </value>
                    
                    <value>
                        <fullName>Complete</fullName>
                        <default>false</default>
                        <label>Complete</label>
                    </value>
                    
                </valueSetDefinition>
            </valueSet>
        </CustomField>