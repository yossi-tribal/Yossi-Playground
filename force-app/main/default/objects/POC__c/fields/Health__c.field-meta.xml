<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
            <fullName>Health__c</fullName>
            <label>Health</label>
            <description>Overall health of the POC engagement, letting owners flag at-risk engagements at a glance.</description>
            <type>Picklist</type>
            <inlineHelpText>Healthy is on track, Needs Attention requires follow-up, and Unhealthy is at risk. Leave blank until the POC is assessed.</inlineHelpText>
            <required>false</required>
            <trackHistory>false</trackHistory>
            
            <!-- Field Level Security - Visible and Editable for all profiles by default -->
            <securityClassification>Public</securityClassification>
            <complianceGroup>None</complianceGroup>
            
            <valueSet>
                <restricted>true</restricted>
                <valueSetDefinition>
                    <sorted>false</sorted>
                    
                    <value>
                        <fullName>Green</fullName>
                        <default>false</default>
                        <label>Healthy</label>
                    </value>
                    
                    <value>
                        <fullName>Yellow</fullName>
                        <default>false</default>
                        <label>Needs Attention</label>
                    </value>
                    
                    <value>
                        <fullName>Red</fullName>
                        <default>false</default>
                        <label>Unhealthy</label>
                    </value>
                    
                </valueSetDefinition>
            </valueSet>
        </CustomField>
